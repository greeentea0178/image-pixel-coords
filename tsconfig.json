{
  // Extension side (runs in the VS Code extension host / Node.js).
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node", "vscode"],
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true
  },
  "include": ["src"],
  "exclude": ["src/webview"]
}
